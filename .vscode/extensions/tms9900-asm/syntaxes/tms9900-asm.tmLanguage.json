{
  "name": "TMS9900 Assembly",
  "scopeName": "source.tms9900.asm",
  "fileTypes": ["asm"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#mnemonics"
    },
    {
      "include": "#jmpOperands"
    },
    {
      "include": "#labelOperands"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "(;.*$)",
          "name": "comment.line.semicolon.tms9900"
        },
        {
          "match": "(^\\s*\\*.*$)",
          "name": "comment.line.asterisk.tms9900"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.tms9900",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.tms9900"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.tms9900",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.tms9900"
            }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_.$][A-Za-z0-9_.$@-]*):",
          "captures": {
            "1": {
              "name": "entity.name.label.tms9900"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_.$@-])(@[A-Za-z_.$][A-Za-z0-9_.$@-]*)(?![A-Za-z0-9_.$@-])",
          "name": "entity.name.label.tms9900"
        }
      ]
    },
    "jmpOperands": {
      "patterns": [
        {
          "match": "(?i)(\\b(?:jmp|jeq|jne|jgt|jh|jl|jhe|jle|jlt|jlow|jnc|joc|jno|jop|jz)\\b)(?:\\s+)(?![+-]?(?:0x[0-9a-f]+|[0-9]+d|[0-9]+|>[0-9a-f]+|%[01]+))([A-Za-z_.$][A-Za-z0-9_.$@-]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.mnemonic.tms9900"
            },
            "2": {
              "name": "entity.name.label.tms9900"
            }
          }
        },
        {
          "match": "(?i)(\\b(?:jmp|jeq|jne|jgt|jh|jl|jhe|jle|jlt|jlow|jnc|joc|jno|jop|jz)\\b)(?:\\s+)([+-]?(?:0|[1-9]\\d?|1\\d\\d|2[0-4]\\d|25[0-5]))(?![A-Za-z0-9_.$@-])",
          "captures": {
            "1": {
              "name": "keyword.operator.mnemonic.tms9900"
            },
            "2": {
              "name": "constant.numeric.tms9900"
            }
          }
        }
      ]
    },
    "labelOperands": {
      "patterns": [
        {
          "match": "(?i)(?:,\\s*)(?![0-9%>])([A-Za-z_.$][A-Za-z0-9_.$@-]*)",
          "captures": {
            "1": {
              "name": "entity.name.label.tms9900"
            }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i)^\\s*(?:copy|data|byte|text|stri|even|equ|end|macro|endm|ifdef|ifndef|if|endif|include|title|list|nolist|idnt|set|extern|public|org|ref|defs|bss|proc|endp)\\b",
          "name": "storage.type.directive.tms9900"
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "match": "(?i)\\b(?:a|ab|ai|andi|b|bl|blwp|clr|clrc|clro|cmp|div|idle|inc|inv|jeq|jgt|jh|jhe|jl|jle|jlt|jlow|jmp|jnc|jne|joc|jno|jop|jz|l|lac|li|limi|lwpi|mov|mpy|neg|nop|ori|s|sb|sbo|sbz|seto|srl|stst|swpb|soc|szc|szcb|t|tb|x|xor|xop|rtwp|ckof|ckon|rset|rto|rdpm|zip)\\b",
          "name": "keyword.operator.mnemonic.tms9900"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "match": "(?i)(?<![A-Za-z0-9_.$@-])(?:r[0-9]|r1[0-5])(?![A-Za-z0-9_.$@-])",
          "name": "variable.language.register.gp.tms9900"
        },
        {
          "match": "(?i)(?<![A-Za-z0-9_.$@-])(?:wr[0-9]|wr1[0-5])(?![A-Za-z0-9_.$@-])",
          "name": "variable.language.register.work.tms9900"
        },
        {
          "match": "(?i)(?<![A-Za-z0-9_.$@-])(?:st|pc|sp|wp|status)(?![A-Za-z0-9_.$@-])",
          "name": "variable.language.register.special.tms9900"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?i)(?<![A-Za-z0-9_.$@-])([+-]?(?:0x[0-9a-f]+|[0-9]+d|[0-9]+|>[0-9a-f]+|%[01]+))(?![A-Za-z0-9_.$@-])",
          "captures": {
            "1": {
              "name": "constant.numeric.tms9900"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "[+\\-*/=,()\\[\\]#<>]",
          "name": "punctuation.definition.operator.tms9900"
        }
      ]
    }
  }
}
