{
  "editor.quickSuggestions": {
    "comments": "off",
    "strings": "off",
    "other": "off"
  },
  
  // Turn off AI code suggestions
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.parameterHints.enabled": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment.line.semicolon.tms9900, comment.line.asterisk.tms9900",
        "settings": {
          "foreground": "#5CCB73",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "string.quoted.single.tms9900, string.quoted.double.tms9900, constant.character.escape.tms9900",
        "settings": {
          "foreground": "#5FD1FF"
        }
      },
      {
        "scope": "entity.name.label.tms9900",
        "settings": {
          "foreground": "#7FC8FF",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "storage.type.directive.tms9900",
        "settings": {
          "foreground": "#C084FC"
        }
      },
      {
        "scope": "keyword.operator.mnemonic.tms9900",
        "settings": {
          "foreground": "#FFB454",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "variable.language.register.gp.tms9900",
        "settings": {
          "foreground": "#A78BFA"
        }
      },
      {
        "scope": "variable.language.register.work.tms9900",
        "settings": {
          "foreground": "#38BDF8"
        }
      },
      {
        "scope": "variable.language.register.special.tms9900",
        "settings": {
          "foreground": "#F59E0B"
        }
      },
      {
        "scope": "constant.numeric.tms9900",
        "settings": {
          "foreground": "#FFD166"
        }
      },
      {
        "scope": "punctuation.definition.operator.tms9900",
        "settings": {
          "foreground": "#67E8F9"
        }
      }
    ]
  },
    
  "workbench.colorCustomizations": {
  },

  "search.exclude": {
    "build/**": true
  },

  "files.associations": {
    "*.asm": "tms9900-asm"
  },
  "chat.tools.terminal.autoApprove": {
    "/^python3 - <<'PY'\nimport re, pathlib\nfrom collections import defaultdict\n\n# Gather label names across project; exclude local labels like !, \\.if etc\\.\nlabels = set\\(\\)\nfor p in sorted\\(pathlib\\.Path\\('src/modules'\\)\\.glob\\('\\*\\.asm'\\)\\):\n    text = p\\.read_text\\(encoding='utf-8'\\)\n    for line in text\\.splitlines\\(\\):\n        m = re\\.match\\(r'\\\\s\\*\\(\\[A-Za-z0-9_\\.\\]\\+\\)\\\\s\\*:\\\\s\\*\\$', line\\)\n        if m:\n            name = m\\.group\\(1\\)\n            if name and not name\\.startswith\\('\\.'\\) and name != '!':\n                labels\\.add\\(name\\)\n\n# Extract label bodies and call targets\ncalls = defaultdict\\(set\\)\nfor p in sorted\\(pathlib\\.Path\\('src/modules'\\)\\.glob\\('\\*\\.asm'\\)\\):\n    lines = p\\.read_text\\(encoding='utf-8'\\)\\.splitlines\\(\\)\n    for i, line in enumerate\\(lines\\):\n        m = re\\.match\\(r'\\\\s\\*\\(\\[A-Za-z0-9_\\.\\]\\+\\)\\\\s\\*:\\\\s\\*\\$', line\\)\n        if not m:\n            continue\n        func = m\\.group\\(1\\)\n        if not func or func\\.startswith\\('\\.'\\) or func == '!':\n            continue\n        j = i \\+ 1\n        while j < len\\(lines\\) and not re\\.match\\(r'\\\\s\\*\\[A-Za-z0-9_\\.\\]\\+\\\\s\\*:\\\\s\\*\\$', lines\\[j\\]\\):\n            j \\+= 1\n        block = '\\\\n'\\.join\\(lines\\[i\\+1:j\\]\\)\n        # Function calls in this assembly block\n        matches = re\\.findall\\(r'\\\\b\\(\\?:bl\\|bal\\|b\\)\\\\s\\+@\\?\\(\\[A-Za-z0-9_\\.\\]\\+\\)', block\\)\n        for target in matches:\n            if target in labels:\n                calls\\[func\\]\\.add\\(target\\)\n        # Occasionally call via direct target without @, often for local/relative branches; skip those unless they match labels and are not local\\.\n\n# Read current table and inject called functions column\npath = pathlib\\.Path\\('docs/devs/function-bank-table\\.md'\\)\nlines = path\\.read_text\\(encoding='utf-8'\\)\\.splitlines\\(\\)\nout=\\[\\]\nfor idx,line in enumerate\\(lines\\):\n    if idx == 0:\n        out\\.append\\('\\| Function \\| ROM banks \\| Register usage \\| Called functions \\|'\\)\n        out\\.append\\('\\| --- \\| --- \\| --- \\| --- \\|'\\)\n        continue\n    if line\\.startswith\\('\\| --- \\|'\\):\n        continue\n    if not line\\.strip\\(\\)\\.startswith\\('\\|'\\):\n        continue\n    m = re\\.match\\(r'\\\\\\|\\\\s\\*\\(\\.\\*\\?\\)\\\\s\\*\\\\\\|\\\\s\\*\\(\\.\\*\\?\\)\\\\s\\*\\\\\\|\\\\s\\*\\(\\.\\*\\?\\)\\\\s\\*\\\\\\|\\?\\\\s\\*\\$', line\\)\n    if not m:\n        continue\n    func, banks, reg = m\\.groups\\(\\)\n    # handle already-parsed rows with possibly extra delimiter due to prior inconsistent generation\\? no\n    call_list = sorted\\(calls\\.get\\(func, set\\(\\)\\)\\)\n    if not call_list:\n        call_str = '—'\n    else:\n        call_str = ', '\\.join\\(call_list\\)\n    out\\.append\\(f'\\| \\{func\\} \\| \\{banks\\} \\| \\{reg\\} \\| \\{call_str\\} \\|'\\)\n\npath\\.write_text\\('\\\\n'\\.join\\(out\\) \\+ '\\\\n', encoding='utf-8'\\)\nprint\\(f'updated \\{path\\} with \\{len\\(out\\)-2\\} rows'\\)\nprint\\(out\\[2\\]\\)\nprint\\(out\\[-1\\]\\)\nPY$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }

}
